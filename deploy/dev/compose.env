# deploy/compose.yml values for dev (https://dev.zubspace.gg). Game server
# behaviour lives in zubspace_server.toml; scripts/deploy.sh checks that the ports
# below match its `bind`.
COMPOSE_PROFILES=
ZUBSPACE_CLIENT_PORT=7100
ZUBSPACE_SERVER_HTTP_PORT=9301
ZUBSPACE_PROMETHEUS_PORT=9091
ZUBSPACE_TUNNEL_METRICS_PORT=20242
# At most one vCPU, and a quarter of prod's weight under contention, so dev load
# cannot starve prod's 60 Hz tick.
ZUBSPACE_SERVER_CPUS=1
ZUBSPACE_SERVER_CPU_SHARES=256
# X-Robots-Tag on every dev response, so search engines index only prod.
ZUBSPACE_ROBOTS_TAG=noindex

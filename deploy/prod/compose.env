# deploy/compose.yml values for prod (https://zubspace.gg). Game server behaviour
# lives in zubspace_server.toml; scripts/deploy.sh checks that the ports below
# match its `bind`.
COMPOSE_PROFILES=host
ZUBSPACE_CLIENT_PORT=7000
ZUBSPACE_SERVER_HTTP_PORT=9001
ZUBSPACE_PROMETHEUS_PORT=9090
ZUBSPACE_TUNNEL_METRICS_PORT=20241
# All three vCPUs; prod's weight is the default, four times dev's.
ZUBSPACE_SERVER_CPUS=3
ZUBSPACE_SERVER_CPU_SHARES=1024

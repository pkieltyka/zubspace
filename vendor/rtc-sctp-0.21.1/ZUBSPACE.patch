 // This test reproduces an issue related to having regular messages (regular acks) which keep
 // rescheduling the T3RTX timer before it can ever fire.
+/// Zubspace: with `AckMode::DeferToData` a SACK made due by a second packet
+/// rides with the server's next DATA, or goes alone after at most 20 ms.
+#[test]
+fn test_deferred_sack_rides_with_the_next_data_or_its_short_timer() -> Result<()> {
+    let si: u16 = 6;
+    let msg = Bytes::from_static(b"input");
+    for server_writes in [true, false] {
+        let (mut pair, client_ch, server_ch) = create_association_pair(AckMode::DeferToData, 0)?;
+        establish_session_pair(&mut pair, client_ch, server_ch, si)?;
+        pair.drive();
+        pair.client_conn_mut(client_ch).stats.reset();
+        pair.server_conn_mut(server_ch).stats.reset();
+
+        // Two client packets, one after the other.
+        for _ in 0..2 {
+            let now = pair.time;
+            pair.client_stream(client_ch, si)?.write_sctp(
+                now,
+                &msg,
+                PayloadProtocolIdentifier::Binary,
+            )?;
+            pair.drive_client();
+        }
+        // The server takes both; the second makes a SACK due, which waits.
+        pair.drive_server();
+        pair.drive_client();
+        assert_eq!(
+            pair.client_conn_mut(client_ch).stats.get_num_sacks(),
+            0,
+            "no standalone SACK yet"
+        );
+
+        let started = pair.time;
+        if server_writes {
+            let now = pair.time;
+            pair.server_stream(server_ch, si)?.write_sctp(
+                now,
+                &msg,
+                PayloadProtocolIdentifier::Binary,
+            )?;
+            pair.drive_server();
+            pair.drive_client();
+            assert_eq!(pair.time, started, "carried at once by the DATA");
+        } else {
+            pair.drive();
+            assert!(pair.time.duration_since(started) <= Duration::from_millis(20));
+        }
+        assert_eq!(pair.client_conn_mut(client_ch).stats.get_num_sacks(), 1);
+        assert_eq!(
+            pair.server_conn_mut(server_ch).stats.get_num_ack_timeouts(),
+            u64::from(!server_writes)
+        );
+        close_association_pair(&mut pair, client_ch, server_ch, si);
+    }
+    Ok(())
+}

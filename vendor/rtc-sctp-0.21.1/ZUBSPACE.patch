+/// Chunk type bytes of one marshalled packet, in order (Zubspace).
+fn chunk_types(packet: &[u8]) -> Vec<u8> {
+    let mut types = vec![];
+    let mut offset = COMMON_HEADER_SIZE as usize;
+    while offset + 4 <= packet.len() {
+        types.push(packet[offset]);
+        let len = u16::from_be_bytes([packet[offset + 2], packet[offset + 3]]) as usize;
+        offset += len.next_multiple_of(4);
+    }
+    types
+}

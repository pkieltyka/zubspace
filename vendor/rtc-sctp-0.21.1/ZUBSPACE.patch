+#[test]
+fn a_pending_sack_rides_ahead_of_new_data_in_one_packet() {
+    // Zubspace: a SACK still waiting on the delayed-ack timer, or due now,
+    // shares the first DATA packet instead of taking its own datagram.
+    for state in [AckState::Delay, AckState::Immediate] {
+        let mut a = create_association_with_mtu(1191);
+        a.ack_state = state;
+        let chunks = vec![payload_chunk(1, 600), payload_chunk(2, 200)];
+        let mut raw_packets = vec![];
+        let sack = a.take_pending_sack_for(&chunks[0], &mut raw_packets);
+        assert!(sack.is_some());
+        assert_eq!(a.ack_state, AckState::Idle, "the bundled SACK is the ack");
+        assert!(raw_packets.is_empty(), "no standalone SACK datagram");
+        a.bundle_data_chunks_into_packets(chunks, sack.as_ref(), &mut raw_packets);
+        assert_eq!(raw_packets.len(), 1);
+        assert!(raw_packets[0].len() as u32 <= a.mtu);
+        assert_eq!(
+            chunk_types(&raw_packets[0]),
+            vec![CT_SACK.0, CT_PAYLOAD_DATA.0, CT_PAYLOAD_DATA.0]
+        );
+        Packet::unmarshal(&raw_packets[0]).expect("bundled packet parses");
+    }
+    // Nothing pending: nothing taken.
+    let mut a = create_association_with_mtu(1191);
+    let mut raw_packets = vec![];
+    assert!(a
+        .take_pending_sack_for(&payload_chunk(1, 10), &mut raw_packets)
+        .is_none());
+    assert!(raw_packets.is_empty());
+}

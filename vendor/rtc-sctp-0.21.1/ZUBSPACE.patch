+fn a_sack_that_does_not_fit_beside_the_first_data_chunk_goes_alone_first() {
+    let mut a = create_association_with_mtu(1191);
+    a.ack_state = AckState::Delay;
+    // The largest padded DATA chunk that still fits one packet on its own.
+    let full = (a.mtu as usize - COMMON_HEADER_SIZE as usize - DATA_CHUNK_HEADER_SIZE as usize)
+        / 4
+        * 4;
+    let chunks = vec![payload_chunk(1, full), payload_chunk(2, 20)];
+    let mut raw_packets = vec![];
+    let sack = a.take_pending_sack_for(&chunks[0], &mut raw_packets);
+    assert!(sack.is_none());
+    assert_eq!(a.ack_state, AckState::Idle);
+    a.bundle_data_chunks_into_packets(chunks, sack.as_ref(), &mut raw_packets);
+    assert_eq!(chunk_types(&raw_packets[0]), vec![CT_SACK.0]);
+    assert!(raw_packets[1..]
+        .iter()
+        .all(|p| p.len() as u32 <= a.mtu && chunk_types(p).iter().all(|t| *t == CT_PAYLOAD_DATA.0)));
+}

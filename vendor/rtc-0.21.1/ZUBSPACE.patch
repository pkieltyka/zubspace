+#[cfg(test)]
+mod zubspace_tests {
+    use super::*;
+
+    fn accept_open(channel_type: u8, parameter: u32) -> Result<RTCDataChannelInternal> {
+        // RFC 8832 OPEN: type, channel type, priority, reliability, label/protocol lengths.
+        let mut packet = vec![0x03, channel_type, 0, 0];
+        packet.extend_from_slice(&parameter.to_be_bytes());
+        packet.extend_from_slice(&[0, 4, 0, 0]);
+        packet.extend_from_slice(b"game");
+        RTCDataChannelInternal::accept(0, 1, PayloadProtocolIdentifier::Dcep, &packet)
+    }
+
+    #[test]
+    fn remote_dcep_preserves_all_reliability_and_ordering_modes() {
+        for (kind, ordered, lifetime, retransmits) in [
+            (0x00, true, None, None),
+            (0x80, false, None, None),
+            (0x01, true, None, Some(80)),
+            (0x81, false, None, Some(80)),
+            (0x02, true, Some(80), None),
+            (0x82, false, Some(80), None),
+        ] {
+            let channel = accept_open(kind, 80).expect("valid DCEP OPEN");
+            assert_eq!(channel.ordered, ordered);
+            assert_eq!(channel.max_packet_life_time, lifetime);
+            assert_eq!(channel.max_retransmits, retransmits);
+            assert!(!channel.negotiated);
+        }
+    }
+
+    #[test]
+    fn remote_dcep_rejects_unrepresentable_reliability_without_truncation() {
+        for kind in [0x01, 0x81, 0x02, 0x82] {
+            assert!(accept_open(kind, u32::from(u16::MAX)).is_ok());
+            assert!(accept_open(kind, u32::from(u16::MAX) + 1).is_err());
+        }
+    }
+}

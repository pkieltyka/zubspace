+/// Zubspace: microseconds a driver waits after a write wake before flushing,
+/// so messages its application queues on other data channels in the same
+/// instant share the SCTP packets. Zero (the default) flushes at once.
+static WRITE_COALESCE_MICROS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Zubspace: set the write-coalescing wait for all drivers; see
+/// [`WRITE_COALESCE_MICROS`]. Runtime timers round it up to their resolution
+/// (one millisecond on tokio).
+pub fn set_write_coalescing(wait: Duration) {
+    WRITE_COALESCE_MICROS.store(
+        u64::try_from(wait.as_micros()).unwrap_or(u64::MAX),
+        Ordering::Relaxed,
+    );
+}
